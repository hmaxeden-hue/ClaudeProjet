# ---------------------------------------------------------------------------
# AI-Business Radar — Secrets
# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env wird NIEMALS committet (siehe .gitignore).
# ---------------------------------------------------------------------------

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Anthropic API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Optionale Zustellung: E-Mail (SMTP) ---
# Nur nötig, wenn zustellung.email.aktiv: true in config.yaml
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Optionale Zustellung: Telegram ---
# Nur nötig, wenn zustellung.telegram.aktiv: true in config.yaml
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
